# =============================================================================
# VyaraHR Frontend Environment Variables
# Self-Hosted Linux VPS Architecture
# =============================================================================

# Self-Hosted Backend API URL (leave empty in production behind Nginx reverse proxy)
# In local development: http://localhost:54321
VITE_API_URL=http://localhost:54321

# Optional email delivery key
VITE_RESEND_API_KEY=your_resend_api_key
