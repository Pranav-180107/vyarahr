{
  "name": "vyara-hr-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "build": "npm --workspace=frontend run build",
    "lint": "npm --workspace=frontend run lint",
    "preview": "npm --workspace=frontend run preview",
    "server": "npm --workspace=backend run start",
    "server:dev": "npm --workspace=backend run dev",
    "package:hostinger": "node scripts/package_hostinger.mjs",
    "prisma:generate": "npm --workspace=backend run prisma:generate",
    "prisma:pull": "npm --workspace=backend run prisma:pull",
    "prisma:studio": "npm --workspace=backend run prisma:studio"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "concurrently": "^10.0.6"
  }
}
